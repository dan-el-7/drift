{
  "_doc": "Drift visual tokens. Pure black/white plus at most two greys; light theme is the exact inversion of dark. No accent colour: motion and type do the work.",
  "color": {
    "dark":  { "bg": "#000000", "fg": "#FFFFFF", "grey1": "#8A8A8A", "grey2": "#2A2A2A" },
    "light": { "bg": "#FFFFFF", "fg": "#000000", "grey1": "#757575", "grey2": "#D5D5D5" }
  },
  "type": {
    "family": "Geist",
    "fallback": "Inter",
    "numerals": "tabular",
    "scale_px": { "caption": 11, "body": 13, "title": 17, "display": 44, "pin": 56 },
    "tracking_em": { "display": -0.04, "pin": -0.02, "body": 0 }
  },
  "stroke": { "hairline_px": 1, "ring_px": 1.5 },
  "space_px": [4, 8, 12, 16, 24, 32, 48],
  "window": { "width": 380, "height": 520, "radius_px": 14 }
}
